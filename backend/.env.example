# Sao chép file này thành ".env" rồi điền giá trị thật của bạn.
# KHÔNG commit file .env thật lên git (đã có trong .gitignore).

# ----- Máy chủ -----
PORT=4000
NODE_ENV=development
# Domain frontend được phép gọi API (CORS). Dùng * chỉ khi phát triển cục bộ.
CORS_ORIGIN=http://localhost:5500

# ----- MySQL -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fitcore

# ----- JWT (đổi sang chuỗi bí mật dài, ngẫu nhiên khi triển khai thật) -----
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ----- Thanh toán QR (VietQR) -----
BANK_BIN=970422
BANK_ACCOUNT_NUMBER=0346941158
BANK_ACCOUNT_NAME=DIEP QUANG TRUONG
